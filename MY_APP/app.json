{
  "expo": {
    "name": "Salah Tracker",
    "slug": "salah-tracker",
    "version": "1.0.0",
    "scheme": "salahtracker",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-vector-icons/ionicons",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.sadman000.salahtracker"
    }
  }
}
